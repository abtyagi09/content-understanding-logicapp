{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "triggers": {
      "Poll_outlook_inbox": {
        "type": "Recurrence",
        "recurrence": {
          "frequency": "Minute",
          "interval": 2
        }
      }
    },
    "actions": {
      "List_unread_emails_with_attachments": {
        "type": "Http",
        "inputs": {
          "method": "GET",
          "uri": "@{concat('https://graph.microsoft.com/v1.0/users/', appsetting('OUTLOOK_MAILBOX_USER'), '/mailFolders/Inbox/messages?$filter=isRead eq false and hasAttachments eq true&$top=10&$select=id,subject,receivedDateTime')}",
          "authentication": {
            "type": "ManagedServiceIdentity",
            "audience": "https://graph.microsoft.com/"
          }
        },
        "runAfter": {}
      },
      "For_each_email": {
        "type": "Foreach",
        "foreach": "@body('List_unread_emails_with_attachments')?['value']",
        "runtimeConfiguration": {
          "concurrency": {
            "repetitions": 1
          }
        },
        "actions": {
          "Get_attachments": {
            "type": "Http",
            "inputs": {
              "method": "GET",
              "uri": "@{concat('https://graph.microsoft.com/v1.0/users/', appsetting('OUTLOOK_MAILBOX_USER'), '/messages/', items('For_each_email')?['id'], '/attachments?$select=id,name,contentType,size,isInline,contentBytes')}",
              "authentication": {
                "type": "ManagedServiceIdentity",
                "audience": "https://graph.microsoft.com/"
              }
            },
            "runAfter": {},
            "runtimeConfiguration": {
              "secureData": {
                "properties": [
                  "outputs"
                ]
              }
            }
          },
          "Filter_invoice_attachments": {
            "type": "Query",
            "inputs": {
              "from": "@body('Get_attachments')?['value']",
              "where": "@and(equals(item()?['isInline'], false), not(empty(item()?['contentBytes'])), or(contains(toLower(item()?['name']), 'invoice'), endsWith(toLower(item()?['name']), '.pdf'), equals(toLower(item()?['contentType']), 'application/pdf')))"
            },
            "runAfter": {
              "Get_attachments": [
                "Succeeded"
              ]
            }
          },
          "If_invoice_attachments_found": {
            "type": "If",
            "expression": "@greater(length(body('Filter_invoice_attachments')), 0)",
            "actions": {
              "For_each_invoice_attachment": {
                "type": "Foreach",
                "foreach": "@body('Filter_invoice_attachments')",
                "runtimeConfiguration": {
                  "concurrency": {
                    "repetitions": 1
                  }
                },
                "actions": {
                  "Upload_invoice_to_documents_container": {
                    "type": "Http",
                    "inputs": {
                      "method": "PUT",
                      "uri": "@{concat(appsetting('AZURE_STORAGE_BLOB_ENDPOINT'), appsetting('AZURE_STORAGE_CONTAINER_NAME'), '/outlook/', formatDateTime(utcNow(),'yyyyMMdd'), '/', guid(), '-', item()?['name'])}",
                      "headers": {
                        "Content-Type": "application/octet-stream",
                        "x-ms-blob-type": "BlockBlob",
                        "x-ms-version": "2023-11-03"
                      },
                      "authentication": {
                        "type": "ManagedServiceIdentity",
                        "audience": "https://storage.azure.com/"
                      },
                      "body": "@base64ToBinary(item()?['contentBytes'])"
                    },
                    "runAfter": {},
                    "runtimeConfiguration": {
                      "secureData": {
                        "properties": [
                          "inputs",
                          "outputs"
                        ]
                      }
                    }
                  }
                },
                "runAfter": {}
              },
              "Mark_email_as_read": {
                "type": "Http",
                "inputs": {
                  "method": "PATCH",
                  "uri": "@{concat('https://graph.microsoft.com/v1.0/users/', appsetting('OUTLOOK_MAILBOX_USER'), '/messages/', items('For_each_email')?['id'])}",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "authentication": {
                    "type": "ManagedServiceIdentity",
                    "audience": "https://graph.microsoft.com/"
                  },
                  "body": {
                    "isRead": true
                  }
                },
                "runAfter": {
                  "For_each_invoice_attachment": [
                    "Succeeded"
                  ]
                }
              }
            },
            "else": {
              "actions": {}
            },
            "runAfter": {
              "Filter_invoice_attachments": [
                "Succeeded"
              ]
            }
          }
        },
        "runAfter": {
          "List_unread_emails_with_attachments": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
